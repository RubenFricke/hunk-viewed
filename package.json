{
  "name": "hunk-viewed",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub-style Viewed marks for Hunk: fold a reviewed file to one row and see your progress",
  "keywords": [
    "hunk",
    "hunk-extension",
    "code-review",
    "diff",
    "viewed"
  ],
  "homepage": "https://github.com/RubenFricke/hunk-viewed#readme",
  "bugs": {
    "url": "https://github.com/RubenFricke/hunk-viewed/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RubenFricke/hunk-viewed.git"
  },
  "license": "MIT",
  "author": "Ruben Fricke",
  "type": "module",
  "hunk": {
    "apiVersion": 31,
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "hunkdiff": "0.24.0",
    "prettier": "^3.9.10",
    "prettier-plugin-jsdoc": "^1.8.1",
    "typescript": "~6.0.3"
  }
}
